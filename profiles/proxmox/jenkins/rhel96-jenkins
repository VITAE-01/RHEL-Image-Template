name = "rhel96-jenkins"
description = "RHEL 9.6 jenkins server blueprint"
version = "0.0.1"
distro = "rhel-96"

[customizations.bootloader]
hybrid = true

[customizations.locale]
keyboard = "gb"

[customizations.timezone]
timezone = "Europe/London"

[customizations.installer.kickstart]
contents = """
text --non-interactive
reboot --eject
firstboot --disable

rootpw --iscrypted $6$3EUw3vaKQFZMlI7A$lBJ5x6mqsba/dY59k1ziGdmZu7u/ckGzv1WL7UVEEBjkfOs3bchAXTQSZk6/faqPAQ2r198jfHispzCiWQ288/
user --name support --password $6$3EUw3vaKQFZMlI7A$lBJ5x6mqsba/dY59k1ziGdmZu7u/ckGzv1WL7UVEEBjkfOs3bchAXTQSZk6/faqPAQ2r198jfHispzCiWQ288/ --iscrypted --groups wheel

zerombr
ignoredisk --only-use=sda
clearpart --all --initlabel --disklabel=gpt
reqpart
part /boot --fstype=xfs --ondisk=sda --size=1024
part pv.0 --fstype=lvmpv --ondisk=sda --size=1 --grow
volgroup rhel --pesize=4096 pv.0
logvol /tmp --vgname=rhel --name=tmp --fstype=xfs --size=4096
logvol /var --vgname=rhel --name=var --fstype=xfs --size=4096
logvol / --vgname=rhel --name=root --fstype=xfs --size=5120
logvol /home --vgname=rhel --name=home --fstype=xfs --size=4096
logvol /opt --vgname=rhel --name=opt --fstype=xfs --size=5120
logvol /var/log/audit --vgname=rhel --name=audit --fstype=xfs --size=4096
logvol /var/lib/jenkins --vgname=rhel --name=lv_jenkins --fstype=xfs --size=14336
logvol swap --vgname=rhel --name=swap --fstype=swap --size=2048
logvol /var/tmp --vgname=rhel --name=var_tmp --fstype=xfs --size=2048
logvol /var/log --vgname=rhel --name=var_log --fstype=xfs --size=4096
network --bootproto=dhcp --device=ens18 --ipv6=auto --activate
"""