name = "rhel96-os-composer"
description = "RHEL 9.6 os-composer server installer"
version = "0.0.1"
distro = "rhel-96"

[customizations.installer.kickstart]
contents = """
text --non-interactive
lang en_GB
keyboard --xlayouts='gb'
timezone Europe/London --utc
rootpw --iscrypted $6$0H5rUfhEngv98lCs$7wKUxk0lB6PuFCbeAYCC2Ce47jEJxjHo45505lub7uZRItly62G9fFx7l1W40k4NPmNQ93MCYijdvU0P9wafX.
reboot
zerombr
clearpart --all --initlabel --disklabel=gpt
reqpart
part /boot --fstype=xfs --ondisk=sda --size=1024
part pv.0 --fstype=lvmpv --ondisk=sda --size=1 --grow
volgroup rhel pv.0
logvol / --vgname=rhel --name=root --fstype=xfs --size=5120
logvol /home --vgname=rhel --name=home --fstype=xfs --size=2048
logvol /opt --vgname=rhel --name=opt --fstype=xfs --size=7168
logvol /var/log/audit --vgname=rhel --name=audit --fstype=xfs --size=1024
logvol /var/cache/osbuild-worker --vgname=rhel --name=lv_osbuild_worker --fstype=xfs --size=20480
logvol /var/lib/osbuild-composer --vgname=rhel --name=lv_osbuild_composer --fstype=xfs --size=12288
logvol swap --vgname=rhel --name=swap --fstype=swap --size=2048
network --bootproto=dhcp --device=ens18 --ipv6=auto --activate
firstboot --disable
"""
